 #include <dlfcn.h> /* to load libraries*/
+#ifdef __EMSCRIPTEN__
+/* Fritzing web app: the code models are linked in (docker/wasm/ngspice/static_codemodels.c) */
+void *static_cm_dlopen(const char *name, int mode);
+void *static_cm_dlsym(void *library, const char *name);
+char *static_cm_dlerror(void);
+#define dlopen static_cm_dlopen
+#define dlsym static_cm_dlsym
+#define dlerror static_cm_dlerror
+#endif
 typedef void * funptr_t;
